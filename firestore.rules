rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'noreply.jeetbuzzaff@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidCategory(cat) {
      return cat in [
        'Flash Tools',
        'Stock Firmware',
        'USB Drivers',
        'FRP & Unlock',
        'QCN & Security',
        'Repair Guides'
      ];
    }

    function isValidChipset(chip) {
      return chip in [
        'MediaTek (MTK)',
        'Qualcomm Snapdragon',
        'Unisoc (SPD)',
        'Exynos',
        'Kirin',
        'Apple Silicon',
        'Universal'
      ];
    }

    function isValidHeaderTheme(theme) {
      return theme in ['navy', 'cobalt', 'emerald', 'charcoal', 'white'];
    }

    function isValidFlashFile(data) {
      return data.keys().hasAll([
        'title', 'brand', 'model', 'category', 'chipset', 'version',
        'fileName', 'fileSizeBytes', 'driveFileId', 'downloadUrl',
        'viewUrl', 'notes', 'isPublicDrive', 'uploadedByUid',
        'uploadedByName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'title', 'brand', 'model', 'category', 'chipset', 'version',
        'fileName', 'fileSizeBytes', 'driveFileId', 'downloadUrl',
        'viewUrl', 'notes', 'price', 'isPublicDrive', 'uploadedByUid',
        'uploadedByName', 'createdAt', 'updatedAt'
      ])
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
      && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 50
      && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
      && data.category is string && isValidCategory(data.category)
      && data.chipset is string && isValidChipset(data.chipset)
      && data.version is string && data.version.size() >= 1 && data.version.size() <= 60
      && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
      && data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 107374182400
      && data.driveFileId is string && data.driveFileId.size() >= 5 && data.driveFileId.size() <= 120 && data.driveFileId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.downloadUrl is string && data.downloadUrl.size() >= 10 && data.downloadUrl.size() <= 400 && data.downloadUrl.matches('^https://.*')
      && data.viewUrl is string && data.viewUrl.size() >= 10 && data.viewUrl.size() <= 400 && data.viewUrl.matches('^https://.*')
      && data.notes is string && data.notes.size() <= 1000
      && (!('price' in data) || (data.price is number && data.price >= 0 && data.price <= 1000000))
      && data.isPublicDrive is bool
      && data.uploadedByUid is string && isValidId(data.uploadedByUid)
      && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 80
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
      && data.uid is string && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.role == 'admin'
      && data.createdAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
        'shopMapEnabled', 'shopName', 'shopAddress', 'shopLat', 'shopLng',
        'shopPinSet', 'headerBgTheme', 'adsenseEnabled', 'adsensePublisherId',
        'adsenseSlotTop', 'adsenseSlotBottom', 'updatedAt', 'updatedByUid'
      ])
      && data.keys().hasOnly([
        'shopMapEnabled', 'shopName', 'shopAddress', 'shopLat', 'shopLng',
        'shopPinSet', 'headerBgTheme', 'adsenseEnabled', 'adsensePublisherId',
        'adsenseSlotTop', 'adsenseSlotBottom', 'updatedAt', 'updatedByUid'
      ])
      && data.shopMapEnabled is bool
      && data.shopName is string && data.shopName.size() >= 2 && data.shopName.size() <= 120
      && data.shopAddress is string && data.shopAddress.size() <= 300
      && data.shopLat is number && data.shopLat >= -90 && data.shopLat <= 90
      && data.shopLng is number && data.shopLng >= -180 && data.shopLng <= 180
      && data.shopPinSet is bool
      && data.headerBgTheme is string && isValidHeaderTheme(data.headerBgTheme)
      && data.adsenseEnabled is bool
      && data.adsensePublisherId is string && data.adsensePublisherId.size() <= 40 && (data.adsensePublisherId == '' || data.adsensePublisherId.matches('^ca-pub-[0-9]{10,20}$'))
      && data.adsenseSlotTop is string && data.adsenseSlotTop.size() <= 30 && (data.adsenseSlotTop == '' || data.adsenseSlotTop.matches('^[0-9]{6,20}$'))
      && data.adsenseSlotBottom is string && data.adsenseSlotBottom.size() <= 30 && (data.adsenseSlotBottom == '' || data.adsenseSlotBottom.matches('^[0-9]{6,20}$'))
      && data.updatedAt is timestamp
      && data.updatedByUid is string && isValidId(data.updatedByUid);
    }

    match /flash_files/{fileId} {
      allow get: if isValidId(fileId) && (resource.data.isPublicDrive == true || isAdmin());
      allow list: if resource.data.isPublicDrive == true || isBootstrappedAdmin() || (isVerifiedUser() && resource.data.uploadedByUid == request.auth.uid);

      allow create: if isAdmin()
        && isValidId(fileId)
        && isValidFlashFile(incoming())
        && incoming().uploadedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(fileId)
        && isValidFlashFile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'brand', 'model', 'category', 'chipset',
          'version', 'notes', 'price', 'isPublicDrive', 'updatedAt'
        ])
        && incoming().uploadedByUid == existing().uploadedByUid
        && incoming().driveFileId == existing().driveFileId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(fileId);
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if isBootstrappedAdmin() && resource.data.role == 'admin';

      allow create: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdminDoc(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;

      allow update: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdminDoc(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt;

      allow delete: if isBootstrappedAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /site_settings/{settingId} {
      allow get: if settingId == 'public';
      allow list: if isBootstrappedAdmin();

      allow create, update: if isAdmin()
        && settingId == 'public'
        && isValidSiteSettings(incoming())
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }
  }
}
