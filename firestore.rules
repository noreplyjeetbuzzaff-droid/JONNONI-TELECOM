rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailKey(id) {
      return id is string && id.size() >= 5 && id.size() <= 160 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasTokenEmail() {
      return isVerifiedUser()
        && 'email' in request.auth.token
        && request.auth.token.email is string;
    }

    function isPrimaryAdmin() {
      return hasTokenEmail()
        && request.auth.token.email.lower() == 'noreply.jeetbuzzaff@gmail.com';
    }

    function isDefaultSecondaryEmail() {
      return hasTokenEmail()
        && request.auth.token.email.lower() in [
          'sflove087@gmail.com',
          'jononitelecom266366@gmail.com'
        ];
    }

    function hasManagedAccountDoc() {
      return hasTokenEmail()
        && exists(/databases/$(database)/documents/admin_accounts/$(request.auth.token.email.lower()));
    }

    function isActiveManagedAccount() {
      return hasManagedAccountDoc()
        && get(/databases/$(database)/documents/admin_accounts/$(request.auth.token.email.lower())).data.active == true;
    }

    function isDefaultActiveSecondaryAdmin() {
      return isDefaultSecondaryEmail()
        && (!hasManagedAccountDoc() || isActiveManagedAccount());
    }

    function isBootstrappedAdmin() {
      return isPrimaryAdmin() || isDefaultActiveSecondaryAdmin();
    }

    function isLegacyUidAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (!hasManagedAccountDoc() || isActiveManagedAccount());
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || isActiveManagedAccount()
        || isDefaultActiveSecondaryAdmin()
        || isLegacyUidAdmin();
    }

    function hasPermission(perm) {
      return isPrimaryAdmin()
        || (
          isActiveManagedAccount()
          && perm in get(/databases/$(database)/documents/admin_accounts/$(request.auth.token.email.lower())).data.permissions
          && get(/databases/$(database)/documents/admin_accounts/$(request.auth.token.email.lower())).data.permissions[perm] == true
        )
        || (
          !hasManagedAccountDoc()
          && (isDefaultSecondaryEmail() || isLegacyUidAdmin())
          && perm != 'manageAdmins'
        );
    }

    function canManageAdmins() {
      return isPrimaryAdmin() || hasPermission('manageAdmins');
    }

    function isValidCategory(cat) {
      return cat in [
        'Flash Tools',
        'Stock Firmware',
        'USB Drivers',
        'FRP & Unlock',
        'QCN & Security',
        'Repair Guides'
      ];
    }

    function isValidChipset(chip) {
      return chip in [
        'MediaTek (MTK)',
        'Qualcomm Snapdragon',
        'Unisoc (SPD)',
        'Exynos',
        'Kirin',
        'Apple Silicon',
        'Universal'
      ];
    }

    function isValidHeaderTheme(theme) {
      return theme in ['navy', 'cobalt', 'emerald', 'charcoal', 'white'];
    }

    function isValidAdminRole(role) {
      return role in ['super_admin', 'admin', 'moderator', 'viewer'];
    }

    function isValidPermissionsMap(perms) {
      return perms is map
        && perms.keys().hasAll([
          'manageFiles',
          'viewVisitors',
          'manageSeo',
          'manageSettings',
          'viewLoginHistory',
          'manageAdmins'
        ])
        && perms.keys().hasOnly([
          'manageFiles',
          'viewVisitors',
          'manageSeo',
          'manageSettings',
          'viewLoginHistory',
          'manageAdmins'
        ])
        && perms.manageFiles is bool
        && perms.viewVisitors is bool
        && perms.manageSeo is bool
        && perms.manageSettings is bool
        && perms.viewLoginHistory is bool
        && perms.manageAdmins is bool;
    }

    function isValidAdminAccount(data) {
      return data.keys().hasAll([
        'email', 'displayName', 'role', 'active', 'permissions',
        'createdByUid', 'createdByEmail', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'email', 'displayName', 'role', 'active', 'permissions',
        'note', 'createdByUid', 'createdByEmail', 'createdAt', 'updatedAt'
      ])
      && data.email is string && isValidEmailKey(data.email) && data.email == data.email.lower()
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.role is string && isValidAdminRole(data.role)
      && data.active is bool
      && isValidPermissionsMap(data.permissions)
      && (!('note' in data) || (data.note is string && data.note.size() <= 200))
      && data.createdByUid is string && isValidId(data.createdByUid)
      && data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 160
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidFlashFile(data) {
      return data.keys().hasAll([
        'title', 'brand', 'model', 'category', 'chipset', 'version',
        'fileName', 'fileSizeBytes', 'driveFileId', 'downloadUrl',
        'viewUrl', 'notes', 'isPublicDrive', 'uploadedByUid',
        'uploadedByName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'title', 'brand', 'model', 'category', 'chipset', 'version',
        'fileName', 'fileSizeBytes', 'driveFileId', 'downloadUrl',
        'viewUrl', 'notes', 'price', 'downloadCount', 'isPublicDrive',
        'uploadedByUid', 'uploadedByName', 'createdAt', 'updatedAt'
      ])
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
      && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 50
      && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
      && data.category is string && isValidCategory(data.category)
      && data.chipset is string && isValidChipset(data.chipset)
      && data.version is string && data.version.size() >= 1 && data.version.size() <= 60
      && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
      && data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 107374182400
      && data.driveFileId is string && data.driveFileId.size() >= 5 && data.driveFileId.size() <= 120 && data.driveFileId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.downloadUrl is string && data.downloadUrl.size() >= 10 && data.downloadUrl.size() <= 400 && data.downloadUrl.matches('^https://.*')
      && data.viewUrl is string && data.viewUrl.size() >= 10 && data.viewUrl.size() <= 400 && data.viewUrl.matches('^https://.*')
      && data.notes is string && data.notes.size() <= 1000
      && (!('price' in data) || (data.price is number && data.price >= 0 && data.price <= 1000000))
      && (!('downloadCount' in data) || (data.downloadCount is int && data.downloadCount >= 0 && data.downloadCount <= 100000000))
      && data.isPublicDrive is bool
      && data.uploadedByUid is string && isValidId(data.uploadedByUid)
      && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 80
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
      && data.uid is string && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.role == 'admin'
      && data.createdAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
        'shopMapEnabled', 'shopName', 'shopAddress', 'shopLat', 'shopLng',
        'shopPinSet', 'headerBgTheme', 'adsenseEnabled', 'adsensePublisherId',
        'adsenseSlotTop', 'adsenseSlotBottom', 'updatedAt', 'updatedByUid'
      ])
      && data.keys().hasOnly([
        'shopMapEnabled', 'shopName', 'shopAddress', 'shopLat', 'shopLng',
        'shopPinSet', 'shopOpen24Hours', 'shopStatusNote', 'headerBgTheme',
        'adsenseEnabled', 'adsensePublisherId', 'adsenseSlotTop',
        'adsenseSlotBottom', 'seoDescription', 'seoKeywords',
        'tickerBgColor', 'tickerBorderColor', 'tickerBadgeBgColor',
        'updatedAt', 'updatedByUid'
      ])
      && data.shopMapEnabled is bool
      && data.shopName is string && data.shopName.size() >= 2 && data.shopName.size() <= 120
      && data.shopAddress is string && data.shopAddress.size() <= 300
      && data.shopLat is number && data.shopLat >= -90 && data.shopLat <= 90
      && data.shopLng is number && data.shopLng >= -180 && data.shopLng <= 180
      && data.shopPinSet is bool
      && (!('shopOpen24Hours' in data) || data.shopOpen24Hours is bool)
      && (!('shopStatusNote' in data) || (data.shopStatusNote is string && data.shopStatusNote.size() <= 140))
      && data.headerBgTheme is string && isValidHeaderTheme(data.headerBgTheme)
      && data.adsenseEnabled is bool
      && data.adsensePublisherId is string && data.adsensePublisherId.size() <= 40 && (data.adsensePublisherId == '' || data.adsensePublisherId.matches('^ca-pub-[0-9]{10,20}$'))
      && data.adsenseSlotTop is string && data.adsenseSlotTop.size() <= 30 && (data.adsenseSlotTop == '' || data.adsenseSlotTop.matches('^[0-9]{6,20}$'))
      && data.adsenseSlotBottom is string && data.adsenseSlotBottom.size() <= 30 && (data.adsenseSlotBottom == '' || data.adsenseSlotBottom.matches('^[0-9]{6,20}$'))
      && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 320))
      && (!('seoKeywords' in data) || (data.seoKeywords is string && data.seoKeywords.size() <= 500))
      && (!('tickerBgColor' in data) || (data.tickerBgColor is string && data.tickerBgColor.size() == 7 && data.tickerBgColor.matches('^#[0-9a-fA-F]{6}$')))
      && (!('tickerBorderColor' in data) || (data.tickerBorderColor is string && data.tickerBorderColor.size() == 7 && data.tickerBorderColor.matches('^#[0-9a-fA-F]{6}$')))
      && (!('tickerBadgeBgColor' in data) || (data.tickerBadgeBgColor is string && data.tickerBadgeBgColor.size() == 7 && data.tickerBadgeBgColor.matches('^#[0-9a-fA-F]{6}$')))
      && data.updatedAt is timestamp
      && data.updatedByUid is string && isValidId(data.updatedByUid);
    }

    function isValidVisitorEvent(data) {
      return data.keys().hasAll([
        'type', 'path', 'label', 'device', 'browser', 'os',
        'referrer', 'visitorHash', 'dayKey', 'createdAt'
      ])
      && data.keys().hasOnly([
        'type', 'path', 'label', 'device', 'browser', 'os',
        'referrer', 'trafficSource', 'visitorHash', 'dayKey', 'ipAddress',
        'deviceName', 'searchKeyword', 'createdAt'
      ])
      && data.type in ['pageview', 'search', 'download']
      && data.path is string && data.path.size() >= 1 && data.path.size() <= 120
      && data.label is string && data.label.size() <= 120
      && data.device in ['mobile', 'desktop', 'tablet']
      && data.browser is string && data.browser.size() >= 1 && data.browser.size() <= 40
      && data.os is string && data.os.size() >= 1 && data.os.size() <= 40
      && data.referrer is string && data.referrer.size() <= 180
      && (!('trafficSource' in data) || (data.trafficSource is string && data.trafficSource.size() <= 60))
      && data.visitorHash is string && data.visitorHash.size() >= 4 && data.visitorHash.size() <= 64 && data.visitorHash.matches('^[a-zA-Z0-9_\\-]+$')
      && data.dayKey is string && data.dayKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 64))
      && (!('deviceName' in data) || (data.deviceName is string && data.deviceName.size() <= 100))
      && (!('searchKeyword' in data) || (data.searchKeyword is string && data.searchKeyword.size() <= 120))
      && data.createdAt is timestamp;
    }

    function isValidVisitorPresence(data) {
      return data.keys().hasAll(['id', 'device', 'browser', 'os', 'path', 'lastSeenAt'])
      && data.keys().hasOnly([
        'id', 'device', 'browser', 'os', 'path',
        'ipAddress', 'deviceName', 'searchKeyword', 'trafficSource', 'lastSeenAt'
      ])
      && data.id is string && data.id.size() >= 4 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
      && data.device in ['mobile', 'desktop', 'tablet']
      && data.browser is string && data.browser.size() >= 1 && data.browser.size() <= 40
      && data.os is string && data.os.size() >= 1 && data.os.size() <= 40
      && data.path is string && data.path.size() >= 1 && data.path.size() <= 120
      && (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 64))
      && (!('deviceName' in data) || (data.deviceName is string && data.deviceName.size() <= 100))
      && (!('searchKeyword' in data) || (data.searchKeyword is string && data.searchKeyword.size() <= 120))
      && (!('trafficSource' in data) || (data.trafficSource is string && data.trafficSource.size() <= 60))
      && data.lastSeenAt is timestamp;
    }

    function isValidLoginHistory(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'eventType', 'status',
        'deviceType', 'deviceName', 'browser', 'os', 'ipAddress',
        'errorMessage', 'createdAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'eventType', 'status',
        'deviceType', 'deviceName', 'browser', 'os', 'ipAddress',
        'errorMessage', 'createdAt'
      ])
      && data.uid is string && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.eventType in ['admin_login', 'drive_connect', 'gmail_connect', 'drive_blocked', 'logout']
      && data.status in ['success', 'blocked', 'failed']
      && data.deviceType in ['mobile', 'desktop', 'tablet']
      && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
      && data.browser is string && data.browser.size() >= 1 && data.browser.size() <= 40
      && data.os is string && data.os.size() >= 1 && data.os.size() <= 40
      && data.ipAddress is string && data.ipAddress.size() >= 1 && data.ipAddress.size() <= 64
      && data.errorMessage is string && data.errorMessage.size() <= 240
      && data.createdAt is timestamp;
    }

    match /flash_files/{fileId} {
      allow get: if isValidId(fileId) && (resource.data.isPublicDrive == true || hasPermission('manageFiles'));
      allow list: if resource.data.isPublicDrive == true || hasPermission('manageFiles') || (isAdmin() && resource.data.uploadedByUid == request.auth.uid);

      allow create: if hasPermission('manageFiles')
        && isValidId(fileId)
        && isValidFlashFile(incoming())
        && incoming().uploadedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(fileId)
        && isValidFlashFile(incoming())
        && (
          (
            hasPermission('manageFiles')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'brand', 'model', 'category', 'chipset',
              'version', 'notes', 'price', 'isPublicDrive', 'updatedAt'
            ])
            && incoming().uploadedByUid == existing().uploadedByUid
            && incoming().driveFileId == existing().driveFileId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          )
          || (
            existing().isPublicDrive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount'])
            && (
              ('downloadCount' in existing() && existing().downloadCount is int && incoming().downloadCount == existing().downloadCount + 1)
              || (!('downloadCount' in existing()) && incoming().downloadCount == 1)
            )
          )
        );

      allow delete: if hasPermission('manageFiles') && isValidId(fileId);
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (canManageAdmins() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if canManageAdmins() && resource.data.role == 'admin';

      allow create: if canManageAdmins()
        && isValidId(adminUid)
        && isValidAdminDoc(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;

      allow update: if canManageAdmins()
        && isValidId(adminUid)
        && isValidAdminDoc(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt;

      allow delete: if canManageAdmins() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /admin_accounts/{emailKey} {
      allow get: if isValidEmailKey(emailKey) && (
        canManageAdmins()
        || (hasTokenEmail() && request.auth.token.email.lower() == emailKey)
      );
      allow list: if canManageAdmins() && resource.data.role in ['super_admin', 'admin', 'moderator', 'viewer'];

      allow create: if canManageAdmins()
        && isValidEmailKey(emailKey)
        && emailKey != 'noreply.jeetbuzzaff@gmail.com'
        && isValidAdminAccount(incoming())
        && incoming().email == emailKey
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if canManageAdmins()
        && isValidEmailKey(emailKey)
        && emailKey != 'noreply.jeetbuzzaff@gmail.com'
        && isValidAdminAccount(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'role', 'active', 'permissions', 'note', 'updatedAt'
        ])
        && incoming().email == existing().email
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByEmail == existing().createdByEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if canManageAdmins()
        && isValidEmailKey(emailKey)
        && emailKey != 'noreply.jeetbuzzaff@gmail.com'
        && hasTokenEmail()
        && emailKey != request.auth.token.email.lower();
    }

    match /site_settings/{settingId} {
      allow get: if settingId == 'public';
      allow list: if isPrimaryAdmin();

      allow create, update: if (hasPermission('manageSettings') || hasPermission('manageSeo'))
        && settingId == 'public'
        && isValidSiteSettings(incoming())
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    match /visitor_events/{eventId} {
      allow get: if hasPermission('viewVisitors') && isValidId(eventId);
      allow list: if hasPermission('viewVisitors');

      allow create: if isValidId(eventId)
        && isValidVisitorEvent(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if hasPermission('viewVisitors') && isValidId(eventId);
    }

    match /visitor_presence/{sessionId} {
      allow get: if hasPermission('viewVisitors') && isValidId(sessionId);
      allow list: if hasPermission('viewVisitors');

      allow create, update: if isValidId(sessionId)
        && isValidVisitorPresence(incoming())
        && incoming().id == sessionId
        && incoming().lastSeenAt == request.time;

      allow delete: if isValidId(sessionId);
    }

    match /login_history/{entryId} {
      allow get: if hasPermission('viewLoginHistory') && isValidId(entryId);
      allow list: if hasPermission('viewLoginHistory');

      allow create: if isAdmin()
        && isValidId(entryId)
        && isValidLoginHistory(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isPrimaryAdmin() && isValidId(entryId);
    }
  }
}
